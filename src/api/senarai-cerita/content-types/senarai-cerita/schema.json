{
  "kind": "collectionType",
  "collectionName": "senarai_ceritas",
  "info": {
    "singularName": "senarai-cerita",
    "pluralName": "senarai-ceritas",
    "displayName": "Senarai Cerita"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "senarai_cerita_section": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::senarai-cerita-section.senarai-cerita-section"
    },
    "KategoryKarya": {
      "type": "enumeration",
      "enum": [
        "artikel",
        "audio",
        "ilustrasi"
      ]
    },
    "audio": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "KategoryKarya"
            },
            "audio"
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "author_karya": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "KategoryKarya"
            },
            "ilustrasi"
          ]
        }
      }
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "blocks",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "url_file": {
      "type": "string"
    }
  }
}
